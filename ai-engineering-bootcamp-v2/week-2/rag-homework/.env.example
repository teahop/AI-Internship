# Copy to .env and fill in. Never commit .env.
# Local and Render use the SAME variable names.

# Required — OpenAI (chat + embeddings)
OPENAI_API_KEY=

# Required — Pinecone vector store
PINECONE_API_KEY=
PINECONE_INDEX_NAME=bootcamp-northwind

# Optional — isolate homework vectors inside the index
# PINECONE_NAMESPACE=homework

# Optional — chunking (defaults: 800 / 100)
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
