# Google Gemini (ADK) — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Capstone service (week-1). Use 8001 when week-2 RAG already occupies 8000.
WEEK1_BASE_URL=http://127.0.0.1:8001

# Path to cached Ledger JSON (relative to week-3/)
LEDGER_PATH=cache/fixture_001_ledger.json

# LLM query expansion for FTS5 (pediatrician → primary care provider, etc.)
# Default on. Set QUERY_EXPANSION=0 to measure retrieval without expansion.
QUERY_EXPANSION=1
# QUERY_EXPANSION_MODEL=gemini-3.6-flash

# Tier 3 passage budgets (replaced MAX_CONTEXT_CHARS / MAX_PER_SOURCE_CHARS)
# TIER3_MAX_PASSAGES=12
# TIER3_MAX_PER_SOURCE=3

# Optional — USD per 1M tokens for Streamlit cost captions (Flash-class defaults)
# GEMINI_INPUT_USD_PER_MTOK=0.30
# GEMINI_OUTPUT_USD_PER_MTOK=2.50
